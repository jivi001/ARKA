# Database
DATABASE_URL=postgresql+asyncpg://arka:arka@localhost:5432/arka
DATABASE_SYNC_URL=postgresql://arka:arka@localhost:5432/arka

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM Configuration
ARKA_LLM_PROVIDER=openai
ARKA_LLM_MODEL=gpt-4o
ARKA_LLM_API_KEY=your-api-key-here
ARKA_LLM_BASE_URL=
ARKA_LLM_TIMEOUT=30
ARKA_LLM_MAX_RETRIES=3

# Fallback LLM
ARKA_LLM_FALLBACK_PROVIDER=
ARKA_LLM_FALLBACK_MODEL=
ARKA_LLM_FALLBACK_API_KEY=
ARKA_LLM_FALLBACK_BASE_URL=

# Langfuse (Optional)
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENABLED=false

# Application
ARKA_ENV=development
ARKA_LOG_LEVEL=INFO
ARKA_DEBUG=false

# Secrets Backend (env, vault)
ARKA_SECRETS_BACKEND=env
VAULT_ADDR=
VAULT_TOKEN=
