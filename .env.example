# Database
DATABASE_URL=postgresql+asyncpg://arka:arka@localhost:5432/arka
DATABASE_SYNC_URL=postgresql://arka:arka@localhost:5432/arka

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM Configuration (Universal Provider Compatibility)
# Supported: openai, anthropic, openrouter, groq, nvidia, deepseek, gemini
ARKA_LLM_PROVIDER=openrouter
ARKA_LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
ARKA_LLM_API_KEY=your-api-key-here
ARKA_LLM_BASE_URL=https://openrouter.ai/api/v1
ARKA_LLM_TIMEOUT=120
ARKA_LLM_MAX_RETRIES=3

# Optional Provider-Specific API Keys (fallback if ARKA_LLM_API_KEY is unset)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# NVIDIA_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=

# Fallback LLM Profile
ARKA_LLM_FALLBACK_PROVIDER=
ARKA_LLM_FALLBACK_MODEL=
ARKA_LLM_FALLBACK_API_KEY=
ARKA_LLM_FALLBACK_BASE_URL=

# Langfuse (Optional)
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENABLED=false

# Application
ARKA_ENV=development
ARKA_LOG_LEVEL=INFO
ARKA_DEBUG=false

# Secrets Backend (env, vault)
ARKA_SECRETS_BACKEND=env
VAULT_ADDR=
VAULT_TOKEN=
