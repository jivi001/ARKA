.openhands/
graphify-out/
graphify/
.graphify*
[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# ------------------------------------------------------------------------------
# 8. Verification, Scratch & Local Audit Artifacts
# ------------------------------------------------------------------------------
/verification/
/function_inventory.json
scratch/
logs/
*.log
*.log.*
sbom*.json
pip-audit*.json
arka-sandbox-scratch/
arka-test-scratch*/
arka-adv-scratch*/
arka-*-scratch*/
arka-run-*/
arka-exec-*/

# ------------------------------------------------------------------------------
# 9. Frontend — Vite / React / Next.js (Operator Console)
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.vite/
frontend/.vite/
.next/
frontend/.next/
out/
frontend/out/

# Turbopack / Turborepo
.turbo/

# TypeScript incremental build cache & linters
*.tsbuildinfo
.eslintcache

# Next.js auto-generated type declarations
next-env.d.ts

# pnpm & yarn
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Package manager debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
.npm

# Vercel deployment
.vercel

# Tailwind / PostCSS caches
.postcss-cache/

# Frontend test coverage & E2E reports
frontend/coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# ------------------------------------------------------------------------------
# 10. Local Databases & In-Memory Queues (SQLite WAL & SHM)
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
*.db
*.db-journal
*.db-wal
*.db-shm
dump.rdb
*.rdb

# ------------------------------------------------------------------------------
# 11. Sockets, IPC & Process Locks
# ------------------------------------------------------------------------------
*.sock
*.socket
*.pid
*.pid.lock

# ------------------------------------------------------------------------------
# 12. Secrets & Environment Files (Strictly Ignored)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example

# Certificates and private keys
*.pem
*.key
*.cert
*.crt

# ------------------------------------------------------------------------------
# 13. Operating System & Editor Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

.idea/
.vscode/
*.swp
*.swo
*~
*.bak

# ------------------------------------------------------------------------------
# 14. Notebooks & Misc
# ------------------------------------------------------------------------------
.ipynb_checkpoints/

# ------------------------------------------------------------------------------
# 15. Docker & Archives
# ------------------------------------------------------------------------------
*.tar
*.tar.gz
