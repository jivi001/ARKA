{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ARKA Phase Status Schema",
  "type": "object",
  "required": ["phases"],
  "properties": {
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "phase",
          "name",
          "status",
          "target_milestone",
          "description"
        ],
        "properties": {
          "phase": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "name": {
            "type": "string",
            "minLength": 3
          },
          "status": {
            "type": "string",
            "enum": [
              "NOT_STARTED",
              "IN_PROGRESS",
              "BLOCKED",
              "COMPLETE",
              "COMPLETE_WITH_WARNINGS"
            ]
          },
          "target_milestone": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_links": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
