{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ARKA Actor Schema",
  "type": "object",
  "required": ["actors"],
  "properties": {
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "type",
          "trust_zone",
          "capabilities",
          "motivations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ACTOR-[A-Z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 3
          },
          "type": {
            "type": "string",
            "enum": [
              "HUMAN_OPERATOR",
              "HUMAN_REVIEWER",
              "HUMAN_ADMIN",
              "SYSTEM_KERNEL",
              "SYSTEM_BROKER",
              "SYSTEM_INTELLIGENCE",
              "SANDBOXED_WORKER",
              "MALICIOUS_EXTERNAL_TARGET",
              "MALICIOUS_INSIDER",
              "COMPROMISED_AGENT",
              "EXTERNAL_LLM_PROVIDER",
              "SUPPLY_CHAIN_ATTACKER",
              "CI_ENVIRONMENT_ATTACKER"
            ]
          },
          "trust_zone": {
            "type": "string",
            "enum": ["T0", "T1", "T2", "T3", "T4", "T5", "T6", "T7", "T8", "CI"]
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "motivations": {
            "type": "string",
            "minLength": 5
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
