{
  "$schema": "https://arka.security/schemas/bwrap-profile-v1.json",
  "name": "arka-rootless-worker-bwrap",
  "version": "1.0",
  "namespaces": {
    "user": true,
    "pid": true,
    "net": true,
    "ipc": true,
    "uts": true
  },
  "capabilities": {
    "drop_all": true
  },
  "flags": [
    "--die-with-parent",
    "--unshare-user",
    "--unshare-pid",
    "--unshare-net",
    "--unshare-ipc",
    "--unshare-uts",
    "--cap-drop", "ALL"
  ],
  "mounts": [
    { "type": "ro-bind", "src": "/usr", "dest": "/usr" },
    { "type": "symlink", "src": "usr/bin", "dest": "/bin" },
    { "type": "symlink", "src": "usr/lib", "dest": "/lib" },
    { "type": "symlink", "src": "usr/lib64", "dest": "/lib64" },
    { "type": "proc", "dest": "/proc" },
    { "type": "dev", "dest": "/dev" },
    { "type": "tmpfs", "dest": "/tmp" }
  ],
  "resource_limits": {
    "max_wall_clock_timeout_seconds": 30,
    "max_stdout_bytes": 16384,
    "max_stderr_bytes": 16384,
    "sigkill_grace_ms": 500
  }
}
