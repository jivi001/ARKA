{
  "$schema": "https://arka.security/schemas/seccomp-profile-v1.json",
  "name": "arka-rootless-worker-seccomp",
  "version": "1.0",
  "default_action": "ALLOW",
  "comment": "Default action is ALLOW for standard unprivileged syscalls in rootless container, with explicit ERRNO rejection of kernel-attack and privilege escalation vectors.",
  "blocked_syscalls": [
    "ptrace",
    "bpf",
    "mount",
    "umount",
    "umount2",
    "chroot",
    "pivot_root",
    "kexec_load",
    "kexec_file_load",
    "reboot",
    "init_module",
    "finit_module",
    "delete_module",
    "iopl",
    "ioperm",
    "keyctl",
    "userfaultfd",
    "perf_event_open",
    "process_vm_readv",
    "process_vm_writev",
    "syslog",
    "vmsplice",
    "settimeofday",
    "clock_settime",
    "adjtimex"
  ],
  "action_on_blocked": "SCMP_ACT_ERRNO(EPERM)"
}
